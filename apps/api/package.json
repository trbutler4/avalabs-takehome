{
	"name": "@repo/api",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --env-file=.env --import tsx --watch src/server.ts",
		"build": "tsc",
		"start": "node dist/server.js",
		"typecheck": "tsc --noEmit",
		"migrate": "node-pg-migrate -m migrations -j ts",
		"migrate:up": "npm run migrate -- up",
		"migrate:down": "npm run migrate -- down",
		"migrate:create": "node-pg-migrate -m migrations -j ts create"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^8.4.0",
		"@repo/shared": "*",
		"cors": "^2.8.5",
		"express": "^4.21.2",
		"express-rate-limit": "^8.2.1",
		"helmet": "^8.1.0",
		"pg-promise": "^12.3.0",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/helmet": "^0.0.48",
		"@types/node": "^22.10.5",
		"node-pg-migrate": "^8.0.4",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3"
	}
}
